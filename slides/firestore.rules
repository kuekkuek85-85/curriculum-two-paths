rules_version = '2';

// 연수 실시간 인터랙션 전용 규칙.
// 로그인 없이 익명으로 쓰기 때문에, 사용하는 4개 경로만 열고 나머지는 모두 막는다.
// 연수 종료 후 자동으로 닫히도록 만료일을 둔다.
service cloud.firestore {
  match /databases/{database}/documents {

    function duringTraining() {
      return request.time < timestamp.date(2026, 8, 31);
    }

    // 발표자가 현재 활성 인터랙션을 알리는 문서
    match /session/current {
      allow read, write: if duringTraining();
    }

    // 폴 / 퀴즈 응답 — 청중은 생성만, 발표자는 읽기와 초기화(삭제)
    match /responses_poll/{doc} {
      allow read, create, delete: if duringTraining();
    }
    match /responses_quiz/{doc} {
      allow read, create, delete: if duringTraining();
    }

    // 자유 입력 — 숨김 처리를 위해 update 허용
    match /wishes/{doc} {
      allow read, create, update, delete: if duringTraining();
    }
  }
}
